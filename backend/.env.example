# Black_Box backend configuration — copy to .env and adjust.
APP_NAME=Black_Box
DEBUG=false
API_PREFIX=/api/v1

# Storage
DATA_DIR=data
UPLOAD_DIR=data/uploads
CHUNK_CACHE_DIR=data/chunks

# Ingestion guardrails
MAX_UPLOAD_SIZE=26214400
MAX_NUM_PAGES=500
ALLOWED_FORMATS=pdf,docx,html,md

# Server
HOST=0.0.0.0
PORT=8000

# Database (Block B+ state checkpointing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/black_box

# Block A — Alpha Feasibility & Strategy Ingestion Engine
# LLM backend: "ollama" (local, default) | "fake" (deterministic tests/dry-runs)
BLOCK_A_LLM_BACKEND=ollama
BLOCK_A_OLLAMA_MODEL=llama3.2
BLOCK_A_OLLAMA_BASE_URL=http://localhost:11434/v1
# Instructor Pydantic retry cap (spec: max 3 attempts)
BLOCK_A_MAX_RETRIES=3
# Config dir with primitives_registry.json + data_catalog.parquet
# (defaults to the packaged seed catalog; override for production catalogs)
# BLOCK_A_CONFIG_DIR=src/black_box/block_a/config
# Output dir for the validated spec matrix (block_a_specs.json)
BLOCK_A_OUT_DIR=out